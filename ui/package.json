{
  "name": "@ascentui/ui",
  "version": "0.1.0",
  "description": "AscentUI free building blocks: data table, combo box, chart, month grid, form kit (MIT)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./dist/base.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../scripts/copy-css.mjs src dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@ascentui/tokens": "^0.1.0",
    "react": ">=18",
    "recharts": "^2.12.7"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "recharts": "^2.12.7",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.0"
  }
}
