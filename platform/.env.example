# AscentUI platform. Placeholder names only. Never commit real values.
# Real values go in the hosting provider's environment variable settings (docs/SETUP.md step 6).
# For local work copy this file to .env.local, which git ignores.
# Anything left empty runs in mock mode: no payments are taken and nothing is stored.

# Public address of the website, no trailing slash. Buyers return here after paying.
SITE_URL=

# Which payment provider to use: "stripe" or "shopify". Shopify is not implemented (not decided).
PAYMENT_PROVIDER=stripe

# Stripe secret key. SECRET. Stripe dashboard > Developers > API keys. Use the test-mode key first.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret. SECRET. Shown when you create the webhook endpoint (step 7).
STRIPE_WEBHOOK_SECRET=
# Stripe price ids (start with "price_"). Not secret. Stripe dashboard > Product catalogue.
# Individual at the launch price, USD 149.
STRIPE_PRICE_INDIVIDUAL_LAUNCH=
# Individual at the regular price, USD 299.
STRIPE_PRICE_INDIVIDUAL=
# Team at the launch price, USD 399.
STRIPE_PRICE_TEAM_LAUNCH=
# Team at the regular price, USD 699.
STRIPE_PRICE_TEAM=

# Supabase project URL. Not secret. Supabase dashboard > Project settings > API.
SUPABASE_URL=
# Supabase anon (publishable) key. Not secret. Same page.
SUPABASE_ANON_KEY=
# Supabase service role key. SECRET: it bypasses all access rules. Server only. Same page.
SUPABASE_SERVICE_ROLE_KEY=
